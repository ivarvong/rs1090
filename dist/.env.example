# Per-deployment values for dist/deploy.sh. Copy to dist/.env and fill in.
# dist/.env is gitignored — never commit the real file.

# SSH target. Anything `ssh` will accept: a Tailscale MagicDNS name, a
# raw IP, or a Host alias from ~/.ssh/config.
PI_HOST=zulu-1

# Account on the Pi that owns the binary and is in the `plugdev` group
# (required to talk to the RTL-SDR via the rtl-sdr udev rules).
PI_USER=ivar

# Bind address the HTTP/SSE server should listen on. Use 0.0.0.0 to be
# reachable from the LAN/Tailnet; 127.0.0.1 to stay loopback-only.
RS1090_BIND=0.0.0.0:8080

# Receiver location, used for local-CPR fallback decoding. `lat,lon`
# in decimal degrees. Leave empty to disable.
RS1090_REFERENCE=40.70214,-73.98262

# Extra flags passed to the binary after --bind/--reference. Use this
# to enable AVR/Beast TCP, GDL90 UDP, BLE, min-confidence, etc.
RS1090_EXTRA_FLAGS="--gdl90 --avr --beast"

# Subcommand + source-specific flags. Almost always `live` with whatever
# RTL-SDR knobs you want; could also be `file /var/lib/rs1090/cap.iq`.
RS1090_SOURCE="live --auto-gain"

# Cross-compile target triple. aarch64 for Pi 3/4/5/Zero 2 W;
# armv7-unknown-linux-gnueabihf for older 32-bit Pis.
PI_TARGET=aarch64-unknown-linux-gnu
